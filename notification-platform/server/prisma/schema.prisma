// Prisma Schema Definition for Notification-as-a-Service (NaaS) Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RETRYING
  DELIVERED
  BOUNCED
  COMPLAINED
  SCHEDULED
}

enum AttemptStatus {
  SUCCESS
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ==========================================
// CORE ENTITIES
// ==========================================

/// Represents a human user who accesses the management dashboard.
model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]

  @@map("users")
}

/// Represents a customer / tenant organization. Primary tenant boundary.
model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  projects  Project[]

  @@map("organizations")
}

/// Represents membership and role mapping between a User and an Organization.
model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

/// Represents an application/project belonging to an Organization.
model Project {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  templates      Template[]
  notifications  Notification[]
  webhooks       Webhook[]
  events         Event[]
  usageRecords   UsageRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

/// Represents machine-to-machine authentication keys for client applications.
model ApiKey {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([keyPrefix])
  @@map("api_keys")
}

/// Represents a notification template managed within the platform.
model Template {
  id            String         @id @default(uuid())
  projectId     String
  name          String
  channel       Channel
  subject       String?
  body          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, channel])
  @@map("templates")
}

/// Represents a single notification request created by a client application.
model Notification {
  id             String                @id @default(uuid())
  projectId      String
  templateId     String?
  channel        Channel
  recipient      String
  status         NotificationStatus    @default(PENDING)
  idempotencyKey String?
  requestHash    String?
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sentAt         DateTime?
  failedAt       DateTime?
  scheduledAt    DateTime?
  cancelledAt    DateTime?
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template       Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attempts       NotificationAttempt[]
  events         Event[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([projectId, status, scheduledAt])
  @@index([projectId, channel])
  @@index([status])
  @@map("notifications")
}

/// Represents an individual delivery attempt for a notification.
model NotificationAttempt {
  id             String        @id @default(uuid())
  notificationId String
  provider       String
  status         AttemptStatus
  attemptNumber  Int           @default(1)
  errorCode      String?
  errorMessage   String?
  attemptedAt    DateTime      @default(now())
  deliveredAt    DateTime?
  notification   Notification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, attemptedAt(sort: Asc)])
  @@map("notification_attempts")
}

/// Represents a normalized lifecycle event received from a delivery provider or system.
model Event {
  id                String            @id @default(uuid())
  notificationId    String?
  projectId         String
  provider          String
  providerEventId   String?
  providerMessageId String?
  type              String
  metadata          Json?
  occurredAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  notification      Notification?     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries        WebhookDelivery[]

  @@unique([provider, providerEventId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([notificationId])
  @@map("events")
}

/// Represents a webhook endpoint configured by a client application.
model Webhook {
  id         String            @id @default(uuid())
  projectId  String
  url        String
  secret     String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@index([projectId, active])
  @@map("webhooks")
}

/// Represents an attempt to deliver an event payload to a client webhook endpoint.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  eventId        String?
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseBody   String?
  attemptCount   Int                   @default(1)
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([status, nextRetryAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

/// Daily aggregated usage counters per project and channel.
model UsageRecord {
  id             String   @id @default(uuid())
  projectId      String
  date           DateTime
  channel        Channel
  totalCount     Int      @default(0)
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  bouncedCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, channel])
  @@index([projectId, date])
  @@map("usage_records")
}
