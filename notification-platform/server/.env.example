# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/notification_db?schema=public"

# Redis Configuration (BullMQ Queue)
# Local Redis:
REDIS_URL="redis://localhost:6379"
# Or Upstash Redis:
# UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Authentication & Security Secrets
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="24h"
API_KEY_HASH_SECRET="your-api-key-hash-secret-min-32-chars-long"
BCRYPT_SALT_ROUNDS=10
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Delivery Limits & Retry Policy
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# SMTP Email Provider Configuration (Optional for real email delivery)
# Gmail: Host=smtp.gmail.com, Port=587, User=you@gmail.com, Pass=16-character App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Vyro Platform <no-reply@yourdomain.com>"
